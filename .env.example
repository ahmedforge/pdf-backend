# Local development only. Copy to .env and replace these placeholders.
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql+psycopg://pdf_user:replace-with-local-database-password@127.0.0.1:5432/pdf_backend
JWT_SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=replace-with-your-groq-key
CORS_ORIGINS=["http://localhost:5173"]
FILE_STORAGE_BACKEND=local
# For private object storage, set FILE_STORAGE_BACKEND=supabase and configure:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-on-backend-only
# SUPABASE_STORAGE_BUCKET=pdfs
